---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Icon from "../components/Icon.astro";
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import heroImage from "../assets/clothoff-adult-swimwear-editorial.jpg";

const posts = (await getCollection("blog")).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const faqs = [
  { question: "Does this website remove clothes from photos?", answer: "No. This website is an independent safety and education resource. It has no upload field and does not generate clothing-removal or intimate imagery." },
  { question: "What is a safer alternative to ClothOff AI?", answer: "For fashion experiments, use AI virtual try-on, an outfit changer, or a fashion moodboard generator with your own image, a licensed adult model, or a mannequin." },
  { question: "Can I edit someone else’s photo if it is public?", answer: "No. A public photo is not permission for an intimate, misleading, or sexualized edit. Obtain explicit consent for the specific transformation and intended sharing." },
  { question: "What should I check in an AI editor’s privacy policy?", answer: "Check storage duration, training use, subprocessors, deletion controls, account history, data export, and how to submit a removal request." },
  { question: "Why use outfit-to-outfit prompts?", answer: "They produce a clear fashion result while avoiding the attempt to infer what a real person looks like underneath clothing." },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${site.url}/#website`, name: site.name, url: site.url, description: site.description, inLanguage: "en" },
    { "@type": "Organization", "@id": `${site.url}/#organization`, name: site.name, url: site.url, logo: `${site.url}/favicon.svg`, description: site.description },
    { "@type": "WebPage", "@id": `${site.url}/#webpage`, name: "ClothOff AI Safety Guide & Safe Alternatives", url: site.url, isPartOf: { "@id": `${site.url}/#website` }, about: ["ClothOff AI safety", "AI clothing remover risks", "AI virtual try-on", "consent-first photo editing"] },
    { "@type": "FAQPage", mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })) },
  ],
};
---

<BaseLayout title="ClothOff AI Safety Guide & Safe Alternatives" description={site.description} keywords={["ClothOff AI", "ClothOff AI safety", "AI clothing remover risks", "AI virtual try-on", "AI outfit changer"]} jsonLd={jsonLd}>
  <section class="hero">
    <div class="hero-glow"></div>
    <Image class="hero-image" src={heroImage} alt="Adult model in mint swimwear on a sunny beach" widths={[640, 960, 1280, 1586]} sizes="100vw" loading="eager" fetchpriority="high" quality={84} />
    <div class="hero-overlay"></div>
    <div class="hero-content reveal">
      <div class="eyebrow"><span></span> Independent consent-first guide</div>
      <h1>ClothOff AI,<br /><em>reimagined safely.</em></h1>
      <p>Understand ClothOff AI risks, protect image privacy, and discover AI virtual try-on and outfit-changing alternatives built around consent.</p>
      <div class="hero-actions"><a class="button primary" href="#alternatives">Explore safe alternatives <Icon name="arrow" /></a><a class="button ghost" href="/blog/clothoff-ai-safety-guide/">Read the safety guide</a></div>
      <div class="trust-row"><span><Icon name="shield" /> Consent first</span><span><Icon name="lock" /> No uploads</span><span><Icon name="dress" /> Adult swimwear</span><span>18+ education</span></div>
    </div>
    <div class="hero-float reveal"><div class="float-icon"><Icon name="spark" /></div><div><small>SAFE MODE</small><strong>Outfit → Outfit</strong></div><span class="status-dot"></span></div>
    <div class="photo-credit">Editorial image: <a href="https://www.pexels.com/photo/11455873/" target="_blank" rel="noopener noreferrer">Fran Bertucci / Pexels</a> · no endorsement implied</div>
  </section>

  <section class="intro section" id="about">
    <div class="section-kicker">01 / Understand the keyword</div>
    <div class="intro-grid"><h2>What is <span>ClothOff AI?</span></h2><div><p class="lead">ClothOff AI is a search term commonly associated with AI clothing remover and synthetic undressing tools. Those uses create serious consent, privacy, and impersonation risks.</p><p>This independent guide does not offer image uploads or clothing-removal generation. We focus on safer goals: AI virtual try-on, outfit restyling, fashion visualization, privacy checks, and responsible photo editing for consenting adults.</p></div></div>
    <div class="signal-strip"><span>ClothOff AI safety</span><i></i><span>AI clothing remover risks</span><i></i><span>Consent-first photo editing</span><i></i><span>AI virtual try-on</span></div>
  </section>

  <section class="safe-grid section" id="alternatives">
    <div class="section-heading"><div><div class="section-kicker">02 / Better creative paths</div><h2>Keep the creativity.<br /><span>Remove the harm.</span></h2></div><p>Most legitimate fashion goals can be achieved without inferring or exposing a person’s body. Start with one of these consent-first workflows.</p></div>
    <div class="feature-grid">
      <article class="feature-card cyan reveal"><span class="feature-number">01</span><div class="feature-icon"><Icon name="dress" /></div><h3>AI virtual try-on</h3><p>Preview a new visible garment on your own photo, a licensed adult model, or a mannequin.</p><ul><li>Garment-to-garment edits</li><li>Fit and color exploration</li><li>Retail and lookbook concepts</li></ul></article>
      <article class="feature-card violet reveal"><span class="feature-number">02</span><div class="feature-icon"><Icon name="spark" /></div><h3>Outfit restyling</h3><p>Change a blazer, dress, or streetwear look while preserving identity, pose, and background.</p><ul><li>Clear creative brief</li><li>Brand-safe direction</li><li>Fully clothed results</li></ul></article>
      <article class="feature-card pink reveal"><span class="feature-number">03</span><div class="feature-icon"><Icon name="lock" /></div><h3>Privacy-first editing</h3><p>Use non-sensitive images, remove metadata, check retention terms, and delete project files.</p><ul><li>Explicit adult consent</li><li>Minimal data exposure</li><li>Documented deletion</li></ul></article>
    </div>
  </section>

  <section class="check-section section" id="safe-use">
    <div class="check-visual reveal"><div class="scan-line"></div><div class="mini-card"><span class="mini-label">CONSENT CHECK</span><strong>Ready for safe editing</strong><div class="mini-progress"><i></i></div><ul><li><b>✓</b> Adult subject confirmed</li><li><b>✓</b> Clear permission recorded</li><li><b>✓</b> Outfit-to-outfit goal</li><li><b>✓</b> Private source image</li></ul></div></div>
    <div class="check-copy"><div class="section-kicker">03 / Before every edit</div><h2>The ClothOff AI<br /><span>safety checklist.</span></h2><p>Pause before uploading a photo to any AI image editor. A few checks can prevent lasting harm.</p><ol><li><span>01</span><div><strong>Own it or obtain explicit permission</strong><p>Posting permission is not editing permission. Ask for the specific transformation.</p></div></li><li><span>02</span><div><strong>Confirm every person is an adult</strong><p>Never use ambiguous-age images, childhood photos, or pictures with bystanders.</p></div></li><li><span>03</span><div><strong>Read retention and training terms</strong><p>Know where the image goes, how long it stays, and how to delete it.</p></div></li><li><span>04</span><div><strong>Choose a visible replacement garment</strong><p>Describe what to add or restyle, not what to remove.</p></div></li></ol><a class="text-link" href="/blog/clothoff-ai-safety-guide/">Open the complete privacy checklist <Icon name="arrow" /></a></div>
  </section>

  <section class="compare section" id="comparison">
    <div class="section-heading"><div><div class="section-kicker">04 / Compare the intent</div><h2>ClothOff AI vs.<br /><span>safe fashion tools</span></h2></div><p>A useful comparison starts with the purpose of the edit—not just the realism of the output.</p></div>
    <div class="comparison-scroll"><table><thead><tr><th>Approach</th><th>Creative goal</th><th>Consent risk</th><th>Best input</th><th>Our view</th></tr></thead><tbody><tr class="risk-row"><td><strong>Clothing-removal tools</strong><small>Often searched as ClothOff AI</small></td><td>Infer or expose concealed imagery</td><td><span class="risk high">Very high</span></td><td>Sensitive personal photo</td><td>Not recommended</td></tr><tr><td><strong>AI virtual try-on</strong><small>Fashion and retail preview</small></td><td>Replace one visible garment with another</td><td><span class="risk low">Lower</span></td><td>Consenting adult or mannequin</td><td>Recommended with privacy checks</td></tr><tr><td><strong>AI fashion moodboard</strong><small>Concept and art direction</small></td><td>Create a new styled image from a brief</td><td><span class="risk low">Lowest</span></td><td>Synthetic or licensed model</td><td>Best for early concepts</td></tr></tbody></table></div>
  </section>

  <section class="blog-preview section">
    <div class="section-heading"><div><div class="section-kicker">05 / ClothOff AI blog</div><h2>Research before<br /><span>you upload.</span></h2></div><a class="button ghost" href="/blog/">View all guides <Icon name="arrow" /></a></div>
    <div class="post-grid">{posts.map((post, index) => <PostCard post={post} index={index} />)}</div>
  </section>

  <section class="faq section"><div><div class="section-kicker">06 / Frequently asked</div><h2>ClothOff AI<br /><span>questions, answered.</span></h2></div><div class="faq-list">{faqs.map((faq) => <details><summary>{faq.question}<span>+</span></summary><p>{faq.answer}</p></details>)}</div></section>

  <section class="final-cta section"><div class="final-glow"></div><div><span>CREATE RESPONSIBLY</span><h2>A better AI fashion idea<br />starts with consent.</h2><p>Use the ClothOff AI Safe Guide to choose privacy-aware, fully clothed, and purpose-built creative workflows.</p></div><a class="button light" href="/blog/clothoff-ai-vs-virtual-try-on/">Compare safe approaches <Icon name="arrow" /></a></section>
</BaseLayout>

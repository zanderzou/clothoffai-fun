{
  "name": "clothoffai-fun",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/run-astro.mjs dev",
    "build": "node scripts/run-astro.mjs build && node scripts/prepare-sites-build.mjs",
    "preview": "node scripts/run-astro.mjs preview",
    "check": "node scripts/run-astro.mjs check",
    "test:seo": "node scripts/audit-static.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "generate:llms": "node scripts/generate-llms.mjs",
    "test:llms": "node scripts/generate-llms.mjs --check",
    "test:locale-drafts": "node --experimental-strip-types scripts/audit-localized-home.mjs",
    "test:locales": "node scripts/audit-locales.mjs",
    "test:render": "node scripts/check-localized-render.mjs",
    "test:interactions": "node scripts/check-localized-interactions.mjs",
    "test:public": "node scripts/check-public-locales.mjs",
    "test:public-analytics": "node scripts/check-public-analytics.mjs",
    "prebuild": "npm run generate:llms",
    "postbuild": "node scripts/finalize-localized-release.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@shikijs/vscode-textmate": "^10.0.2",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3"
  }
}

---
type IconName = "shield" | "spark" | "dress" | "lock" | "arrow" | "menu";
interface Props { name: IconName; }
const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" aria-hidden="true">
  {name === "shield" && <><path d="M12 2 20 5v6c0 5.2-3.4 9.4-8 11-4.6-1.6-8-5.8-8-11V5l8-3Z"></path><path d="m8.5 12 2.2 2.2 4.9-5"></path></>}
  {name === "spark" && <><path d="m12 2 1.7 5.3L19 9l-5.3 1.7L12 16l-1.7-5.3L5 9l5.3-1.7L12 2Z"></path><path d="m18.5 15 .8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8.8-2.2Z"></path></>}
  {name === "dress" && <><path d="M9 3h6l1 4-2 2 4 11H6l4-11-2-2 1-4Z"></path><path d="M10 3c0 1.5.7 2.5 2 2.5S14 4.5 14 3"></path></>}
  {name === "lock" && <><rect x="4" y="10" width="16" height="11" rx="3"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path><path d="M12 14v3"></path></>}
  {name === "arrow" && <path d="M5 12h14m-5-5 5 5-5 5"></path>}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16"></path>}
</svg>

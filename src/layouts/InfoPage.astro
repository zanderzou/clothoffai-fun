---
import BaseLayout from "./BaseLayout.astro";
interface Props { title: string; description: string; kicker: string; updated?: string; }
const { title, description, kicker, updated = "September 20, 2026" } = Astro.props;
---

<BaseLayout title={`${title} | ClothOff AI Safe Guide`} description={description}>
  <section class="info-hero"><div class="page-orb"></div><div class="section-kicker">{kicker}</div><h1>{title}</h1><p>{description}</p><small>Last updated: {updated}</small></section>
  <article class="info-content"><slot /></article>
</BaseLayout>

---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
interface Props { posts: CollectionEntry<"blog">[]; }
const { posts } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-top">
    <div><a class="brand" href="/"><span class="brand-mark"><Icon name="shield" /></span><span class="brand-copy"><strong>CLOTHOFF<span>AI</span></strong><small>SAFE GUIDE</small></span></a><p>An independent ClothOff AI safety and education resource for consent-first photo editing, virtual try-on, and responsible AI fashion visualization.</p></div>
    <div><h3>Explore</h3><a href="/#about">What is ClothOff AI?</a><a href="/#safe-use">Safety checklist</a><a href="/#alternatives">Safe alternatives</a><a href="/about/">About this guide</a></div>
    <div><h3>ClothOff AI blog</h3>{posts.slice(0, 3).map((post) => <a href={`/blog/${post.id}/`}>{post.data.title}</a>)}</div>
    <div class="footer-legal"><h3>Information</h3><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/editorial-policy/">Editorial policy</a><a href="/contact/">Contact</a></div>
  </div>
  <div class="footer-bottom"><span>© <span data-year>2026</span> ClothOff AI Safe Guide</span><span>Adults only • Consent first • No image uploads</span><span>Independent educational resource</span></div>
</footer>

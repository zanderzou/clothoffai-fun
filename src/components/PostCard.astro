---
import type { CollectionEntry } from "astro:content";
import { formatDate, toIsoDate } from "../data/site";
import Icon from "./Icon.astro";
interface Props { post: CollectionEntry<"blog">; index?: number; compact?: boolean; }
const { post, index = 0, compact = false } = Astro.props;
const iconName = index % 3 === 0 ? "shield" : index % 3 === 1 ? "dress" : "spark";
---

<article class:list={["post-card", post.data.accent]}>
  <a href={`/blog/${post.id}/`} aria-label={`Read ${post.data.title}`}>
    {!compact && <div class="post-art"><span>0{index + 1}</span><div class="post-orbit"></div><Icon name={iconName} /></div>}
    <div class="post-body">
      <div class="post-meta"><span>{post.data.category}</span><time datetime={toIsoDate(post.data.publishDate)}>{formatDate(post.data.publishDate)}</time>{compact && <span>{post.data.readTime}</span>}</div>
      <h3>{post.data.title}</h3><p>{post.data.description}</p><strong>Read guide <Icon name="arrow" /></strong>
    </div>
  </a>
</article>

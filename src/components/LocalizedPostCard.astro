---
import Icon from "./Icon.astro";
import { localizedArticles } from "../data/localized-articles";
import type { ComparisonSlug, Locale } from "../data/locales";
import { ui } from "../data/locales";
interface Props { locale: Locale; slug: ComparisonSlug; index: number; }
const { locale, slug, index } = Astro.props;
const article = localizedArticles[locale]![slug];
const iconName = index % 3 === 0 ? "shield" : index % 3 === 1 ? "dress" : "spark";
---
<article class:list={["post-card", index % 3 === 0 ? "cyan" : index % 3 === 1 ? "violet" : "pink"]}>
  <a href={`/${locale}/blog/${slug}/`} aria-label={article.title}>
    <div class="post-art"><span>0{index + 1}</span><div class="post-orbit"></div><Icon name={iconName} /></div>
    <div class="post-body"><div class="post-meta"><span>0{index + 1} / 05</span></div><h3>{article.title}</h3><p>{article.description}</p><strong>{ui[locale].read} <Icon name="arrow" /></strong></div>
  </a>
</article>
